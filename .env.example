# Copy to .env for local development: cp .env.example .env
# No secrets belong in this file, or in .env — this service has no credentials.
# If your fork adds any (a database URL, an object-store key), inject them from
# your secret manager at runtime and keep them out of the image and the repo.

# --- Service -----------------------------------------------------------------
MLSERVICE_APP_NAME=ml-service-blueprint
MLSERVICE_ENVIRONMENT=local
MLSERVICE_HOST=127.0.0.1
MLSERVICE_PORT=8000

MLSERVICE_REGISTRY_ROOT=registry
MLSERVICE_MODEL_NAME=tabular-classifier
MLSERVICE_MODEL_STAGE=production
# MLSERVICE_MODEL_VERSION=v1
MLSERVICE_MAX_BATCH_SIZE=1000
MLSERVICE_FAIL_FAST_ON_MISSING_MODEL=true

# --- Observability -----------------------------------------------------------
MLSERVICE_OBS_LOG_LEVEL=INFO
MLSERVICE_OBS_LOG_FORMAT=console
MLSERVICE_OBS_LOG_INCLUDE_REQUEST_BODY=false
MLSERVICE_OBS_METRICS_ENABLED=true
MLSERVICE_OBS_METRICS_PATH=/metrics
MLSERVICE_OBS_PREDICTION_HISTOGRAM_ENABLED=true

# Tracing needs the 'otel' extra: pip install -e '.[otel]'
MLSERVICE_OBS_TRACING_ENABLED=false
# MLSERVICE_OBS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
MLSERVICE_OBS_TRACE_SAMPLE_RATIO=0.1

# --- Drift hooks -------------------------------------------------------------
MLSERVICE_OBS_DRIFT_ENABLED=false
MLSERVICE_OBS_DRIFT_SINK=null
MLSERVICE_OBS_DRIFT_SINK_PATH=var/drift/predictions.jsonl
MLSERVICE_OBS_DRIFT_SAMPLE_RATIO=1.0
